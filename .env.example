# ======================================================
# PSA GENERATOR ENVIRONMENT TEMPLATE
# Salin file ini menjadi:
# 1. .env.mgm (untuk instance MGM)
# 2. .env.cmc (untuk instance CMC)
# 
# PERHATIAN: Semua file .env* sudah diabaikan (.gitignore)
# sehingga aman dan TIDAK AKAN TER-UPLOAD ke GitHub!
# ======================================================

# Database Configuration
DATABASE_URL="postgresql://postgres:your_secure_db_password@127.0.0.1:5432/psadatabase"

# JWT Authentication & Seed Password
JWT_SECRET="your_secure_random_string_here_min_32_chars"
SEED_DEFAULT_PASSWORD="your_secure_default_password"

# REDIS Configuration
REDIS_URL="redis://:your_secure_redis_password@127.0.0.1:6379"

# MQTT Configuration
MQTT_HOST=127.0.0.1
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Multi-Site Brand Configuration
# BRAND_* dibaca saat runtime per instance; satu build bisa dipakai bersama.
# NEXT_PUBLIC_BRAND_* lama tetap didukung.
# --- Pengaturan MGM ---
# BRAND_NAME="MGM"
# BRAND_LOGO="/logo-mgm.png"
# BRAND_ICON="/icon-mgm.png"
# BRAND_COLOR="blue"
# AUTO_REGISTER_SN=true
# REDIS_PREFIX="psa:mgm:"

# --- Pengaturan CMC ---
# DATABASE_URL="postgresql://postgres:your_secure_db_password@127.0.0.1:5432/psadatabase_cmc"
# BRAND_NAME="CMC"
# BRAND_LOGO="/logo-cmc.png"
# BRAND_ICON="/icon-cmc.png"
# BRAND_COLOR="red"
# AUTO_REGISTER_SN=false
# REDIS_PREFIX="psa:cmc:"

